# ── Neon Database ─────────────────────────────────────────────────────────────
# Neon dashboard → your project → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Neon Auth ──────────────────────────────────────────────────────────────────
# Neon dashboard → your project → Auth → Configuration → Auth URL
# Looks like: https://ep-xxx.us-east-2.aws.neon.build/neondb/auth
VITE_NEON_AUTH_URL=https://your-auth-url-here
